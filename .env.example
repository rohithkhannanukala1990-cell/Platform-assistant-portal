POSTGRES_PASSWORD=postgres123
REDIS_PASSWORD=redis123
ENV=dev
SECRET_KEY=dev_jwt_secret_change_me
DEFAULT_ADMIN_PASSWORD=Admin123!
GRAFANA_PORT=3002
GRAFANA_PASSWORD=admin123

# Portal URLs & integrations (see GitHub Actions health workflow)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
PORTAL_URL=http://localhost
REDIS_URL=redis://localhost:6379
SENTRY_DSN=your-sentry-dsn-here

# AI — multi-provider LLMService (openai / openai_compatible / anthropic)
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
LLM_MOCK=0
# Local models: set OPENAI_BASE_URL to an OpenAI-compatible server (e.g. http://localhost:11434/v1)

# SAML Single Sign-On (fill in from your IdP provider dashboard)
SAML_SP_ENTITY_ID=        # e.g. https://yourapp.com/saml/metadata
SAML_SP_ACS_URL=          # e.g. https://yourapp.com/api/auth/sso/saml/acs
SAML_SP_CERT=             # Base64 PEM content of your SP certificate
SAML_SP_KEY=              # Base64 PEM content of your SP private key
SAML_IDP_ENTITY_ID=       # Provided by your IdP (Okta, Azure AD, etc.)
SAML_IDP_SSO_URL=         # IdP login URL (auto-detected from metadata if blank)
SAML_IDP_CERT=            # IdP public certificate in Base64 PEM format
SAML_IDP_METADATA_URL=    # Full URL to IdP metadata XML

# Google OAuth 2.0 (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=         # e.g. 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=     # Client secret from Google Cloud Console
GOOGLE_REDIRECT_URI=      # Must match exactly: e.g. http://localhost:8000/oauth/google/callback

# App config
FRONTEND_URL=http://localhost:5173   # Base URL of the React frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ENABLE_DEMO_DATA=true                # CI/CD demo fixtures; false in production unless intentional
ADMIN_EMAILS=                        # Comma-separated emails that get Admin role on SSO login

# Production defaults: see `.env.production.example` and `docs/BETA_GONOGO.md`
# (ENV=production, ENABLE_DEMO_DATA=false, LLM_MOCK=0, ENFORCE_WORKSPACE_ISOLATION=true)
# Required secrets: SECRET_KEY, SECRETS_ENCRYPTION_KEY, LLM keys, GITHUB_WEBHOOK_SECRET

# MCP — client (Settings) + portal server (python -m backend.mcp.server_app)
# See docs/MCP.md
MCP_ENABLED=false
PORTAL_MCP_TOKEN=

# Compliance — audit retention days (also settings key audit_log_retention_days)
AUDIT_LOG_RETENTION_DAYS=90

# MFA policy — comma-separated roles that must enroll MFA before login completes
# Example: MFA_REQUIRED_ROLES=Admin,PlatformAdmin
# Can also be set via settings key mfa_required_roles
MFA_REQUIRED_ROLES=

# JWT sessions — tokens include jti; revoked via /api/auth/sessions/revoke and /api/auth/logout
# JWT_EXPIRE_MINUTES=480
