# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Secrets & environment ─────────────────────────────────────────────────────
backend/.env
*.env
.env.*
# Whitelist example/template files so they are always committed
!*.env.example
!**/.env.example

# ── Databases ─────────────────────────────────────────────────────────────────
backend/*.db
backend/*.db-shm
backend/*.db-wal

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Docker volumes (created at runtime, not source) ──────────────────────────
postgres_data/
redis_data/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
celerybeat-schedule
celerybeat.pid
