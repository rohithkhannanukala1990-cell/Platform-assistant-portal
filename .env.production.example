# Production / pilot environment template (Phase G7).
# Copy to `.env.production` and fill secrets. Never commit the real file.
#
#   cp .env.production.example .env.production
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.production up -d --build

ENV=production
ENABLE_DEMO_DATA=false
ENFORCE_WORKSPACE_ISOLATION=true
LLM_MOCK=0

# Required — generate strong values (no compose/dev defaults)
SECRET_KEY=change_me_use_openssl_rand_hex_32
SECRETS_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POSTGRES_PASSWORD=change_me_strong_postgres_password
REDIS_PASSWORD=change_me_strong_redis_password
DEFAULT_ADMIN_PASSWORD=change_me_strong_admin_password

DEFAULT_ADMIN_USERNAME=admin
JWT_EXPIRE_MINUTES=480
HTTP_PORT=80
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# LLM (or configure providers in Settings after login)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# Optional webhook HMAC
GITHUB_WEBHOOK_SECRET=
