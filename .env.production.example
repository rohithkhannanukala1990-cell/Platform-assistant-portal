# Production / pilot environment template (Phase G7/P6/P8).
# Copy to `.env.production` and fill secrets. Never commit the real file.
#
#   cp .env.production.example .env.production
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.production up -d --build
#
# Generate Fernet key (do not leave blank in a real pilot):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENV=production
ENABLE_DEMO_DATA=false
ENFORCE_WORKSPACE_ISOLATION=true
LLM_MOCK=0

# Required — generate strong values (no compose/dev defaults)
SECRET_KEY=change_me_use_openssl_rand_hex_32
SECRETS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=change_me_strong_postgres_password
REDIS_PASSWORD=change_me_strong_redis_password
DEFAULT_ADMIN_PASSWORD=change_me_strong_admin_password

DEFAULT_ADMIN_USERNAME=admin
# Prefer 60–120 for production pilots (ID-023). Backend reads JWT_EXPIRE_MINUTES
# (default 480 only when unset). Enterprise: use 60 with refresh/re-login.
JWT_EXPIRE_MINUTES=60
HTTP_PORT=80
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Optional soft resource caps (consumed by deploy/docker-compose.prod.yml)
# API_CPU_LIMIT=2.0
# API_MEM_LIMIT=1536M
# WORKER_CPU_LIMIT=2.0
# WORKER_MEM_LIMIT=1536M

# LLM (or configure providers in Settings after login)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# Webhook HMAC (required for signed GitHub webhooks in production)
GITHUB_WEBHOOK_SECRET=

# Optional connector env (prefer Tool Registry vault for per-user accounts)
# PAGERDUTY_API_TOKEN=
# SLACK_BOT_TOKEN=
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# GITLAB_TOKEN=

# Optional SSO placeholders (SAML / Google)
# SAML_IDP_METADATA_URL=
# SAML_SP_ENTITY_ID=
# SAML_SP_ACS_URL=
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ADMIN_EMAILS=
# MFA_REQUIRED_ROLES=Admin
