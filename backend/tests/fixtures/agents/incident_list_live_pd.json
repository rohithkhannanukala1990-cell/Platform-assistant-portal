{
  "description": "Incident list with live PagerDuty mock — evidence ids from mock only",
  "agent": "incident_agent",
  "mode": "run",
  "context": {
    "user_id": "eval-user",
    "user_role": "Admin",
    "environment": "development",
    "tenant_id": "default",
    "workspace_id": "ws-eval"
  },
  "params": {
    "task": "list open incidents"
  },
  "mock_tools": {
    "pagerduty": {
      "list_incidents": [
        {
          "id": "PXXXX01",
          "title": "API latency high",
          "status": "triggered",
          "html_url": "https://example.pagerduty.com/incidents/PXXXX01",
          "service": {"summary": "payments-api"}
        }
      ]
    }
  },
  "expected": {
    "grounding": ["live", "partial"],
    "status_in": ["success"],
    "must_contain": ["PXXXX01"],
    "must_not_contain": ["PINVENTED99", "fake-incident-zzz"],
    "commands_policy": null,
    "commands_empty": true
  }
