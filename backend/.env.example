# Copy this file to .env and fill in your values.
# The real .env is gitignored — never commit secrets.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required for non-test ENV values. Compose also injects a default.
ENV=dev
SECRET_KEY=dev_jwt_secret_change_me

# ── AI / LLM (multi-provider via backend/ai/llm_service.py) ───────────────────
# Defaults: OpenAI. Local models: point OPENAI_BASE_URL at an OpenAI-compatible
# server (vLLM, LiteLLM, Ollama openai compat, LM Studio, etc.).
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# Set LLM_MOCK=1 for deterministic offline responses (pytest sets this).
LLM_MOCK=0
AI_MAX_HISTORY_MESSAGES=20
AI_HITL_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiops

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Jira (optional) ───────────────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Webhook HMAC secrets (optional) ────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your_github_secret
GITLAB_WEBHOOK_SECRET=your_gitlab_secret
PAGERDUTY_WEBHOOK_SECRET=your_pagerduty_secret
DATADOG_WEBHOOK_SECRET=your_datadog_secret

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Demo fixtures (CI/CD runs, DORA, anomaly scanner). Defaults to on in dev/test.
ENABLE_DEMO_DATA=true

# When true, authenticated non-public API calls require a workspace_id
# (from X-Workspace-Id or the user's default workspace).
ENFORCE_WORKSPACE_ISOLATION=false

# Production / enterprise beta: see repo-root `.env.production.example`
# (ENABLE_DEMO_DATA=false, ENV=production, LLM_MOCK=0, ENFORCE_WORKSPACE_ISOLATION=true)
# and docs/BETA_GONOGO.md.

# ── Secrets at rest (ToolAccount credentials) ─────────────────────────────────
# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# ── MCP (Phases M1–M2) ────────────────────────────────────────────────────────
# Client: Settings → MCP Servers. Server: python -m backend.mcp.server_app
MCP_ENABLED=false
PORTAL_MCP_TOKEN=

# ── MFA policy ────────────────────────────────────────────────────────────────
# Comma-separated roles that must enroll MFA before password login succeeds.
# MFA_REQUIRED_ROLES=Admin,PlatformAdmin
MFA_REQUIRED_ROLES=

# ── SSO (SAML + Google) — leave blank to disable buttons / return 400 "not configured"
SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=                 # e.g. http://localhost:8000/api/auth/sso/saml/acs
SAML_SP_CERT=
SAML_SP_KEY=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
SAML_IDP_METADATA_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=             # e.g. http://localhost:8000/api/auth/oauth/google/callback
ADMIN_EMAILS=                    # SSO emails that receive Admin role
