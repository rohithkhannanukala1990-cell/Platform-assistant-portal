# Copy this file to .env and fill in your values.
# The real .env is gitignored — never commit secrets.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required for non-test ENV values. Compose also injects a default.
ENV=dev
SECRET_KEY=dev_jwt_secret_change_me

# ── AI Provider ───────────────────────────────────────────────────────────────
# Switch between "gemini" (cloud) and "ollama" (local Gemma) for legacy triage paths
AI_PROVIDER=ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_MODEL=gemini-1.5-flash
AI_MAX_HISTORY_MESSAGES=20
AI_HITL_ENABLED=true

# ── Ollama (only used when AI_PROVIDER=ollama) ────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiops

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Jira (optional) ───────────────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Webhook HMAC secrets (optional) ────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your_github_secret
GITLAB_WEBHOOK_SECRET=your_gitlab_secret
PAGERDUTY_WEBHOOK_SECRET=your_pagerduty_secret
DATADOG_WEBHOOK_SECRET=your_datadog_secret
