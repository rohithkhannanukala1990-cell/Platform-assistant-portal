    },
    {
      "title": "Celery task failures / retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(celery_task_failures_total[5m])) by (task)",
          "legendFormat": "fail {{task}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(celery_task_retries_total[5m])) by (task)",
          "legendFormat": "retry {{task}}",
          "refId": "B"
